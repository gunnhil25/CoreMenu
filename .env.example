# Docker / GHCR Deployment Configuration
COREMENU_IMAGE="ghcr.io/gunnhil25/coremenu:latest"

# PostgreSQL 16 Credentials
POSTGRES_USER="coremenu_user"
POSTGRES_PASSWORD="change_me_secure_password"
POSTGRES_DB="coremenu"

# Database connection string for PostgreSQL 16 (used for standalone / non-compose runs)
DATABASE_URL="postgres://coremenu_user:change_me_secure_password@localhost:5432/coremenu"
DB_MAX_CONNECTIONS=10

# Local Recipe Photo Uploads Directory
UPLOAD_DIR="/app/data/uploads"

# Session Token Signing Secret (use a long random string in production)
AUTH_SECRET="change_me_auth_secret_key"

# Session Cookie Security (leave blank to auto-detect HTTPS via X-Forwarded-Proto;
# set "true" to force Secure cookies or "false" for plain HTTP)
COOKIE_SECURE=

# Next.js Server Configuration
PORT=3002
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Cloudflare Tunnel / Reverse Proxy Hostname
NEXT_PUBLIC_APP_URL="https://menu.yourdomain.internal"
